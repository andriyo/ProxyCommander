<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>io.github.andriyo.proxycommander</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>ProxyCommander</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="andriyo@gmail.com" url="https://github.com/andriyo/ProxyCommander">Andrii Olefirenko</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p>Android Studio plugin for fast control of <code>adb reverse</code>, device HTTP proxy setup, and optional device time resync across emulators and physical devices used during development.</p>

        <p>Useful when you run a local backend, mock server, or HTTP debugger (Charles, mitmproxy, Proxyman) on your workstation and want connected Android devices to route traffic through it without configuring each one by hand.</p>

        <h3>Actions</h3>
        <ul>
          <li><b>Connect All</b> &mdash; enable <code>adb reverse tcp:&lt;port&gt; tcp:&lt;port&gt;</code> and set <code>global http_proxy</code> on every connected device.</li>
          <li><b>Connect Active Emulator and Clear Others' Proxy</b> &mdash; detect the active emulator from the IDE context, connect reverse/proxy on it, and clear proxy settings on every other connected device.</li>
          <li><b>Disconnect All</b> &mdash; remove reverse mapping and clear all proxy settings (including PAC).</li>
          <li><b>Select Emulator and Disconnect Others</b> &mdash; pick from a list of connected emulators, keep reverse/proxy enabled on the selected emulator, and disconnect all others.</li>
        </ul>

        <h3>Where actions appear</h3>
        <ul>
          <li><code>Tools &rarr; Proxy Commander</code></li>
          <li>Run toolbar, next to the Android attach debugger actions, for the primary connect actions</li>
          <li>Running Devices secondary toolbar for supported quick actions</li>
        </ul>

        <p>Port (default <code>8888</code>), ADB executable path, and the default-on "Reset device clock on connect" option are configurable under <code>Tools &rarr; Proxy Commander &rarr; Settings...</code>. If no ADB path is set, the plugin falls back to <code>$ADB</code> or <code>adb</code> on <code>PATH</code>.</p>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.androidstudio</depends>
    <depends>org.jetbrains.android</depends>
    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <actions>
        <group id="ProxyCommander.ActionsGroup" text="Proxy Commander" description="Proxy Commander device actions" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="ProxyCommander.ConnectAllDevicesAction"
                    class="io.github.andriyo.proxycommander.ConnectAllDevicesAction"
                    text="Connect All"
                    description="Enable reverse proxy and HTTP proxy on all connected devices"
                    icon="/icons/proxy_connect_all.svg"/>
            <action id="ProxyCommander.ConnectActiveEmulatorClearOthersProxyAction"
                    class="io.github.andriyo.proxycommander.ConnectActiveEmulatorClearOthersProxyAction"
                    text="Connect Active Emulator and Clear Others' Proxy"
                    description="Enable reverse/proxy for active emulator and clear proxy settings on all other connected devices"
                    icon="/icons/proxy_connect_active.svg"/>
            <action id="ProxyCommander.DisconnectAllDevicesAction"
                    class="io.github.andriyo.proxycommander.DisconnectAllDevicesAction"
                    text="Disconnect All"
                    description="Disable reverse proxy and clear HTTP proxy on all connected devices"
                    icon="/icons/proxy_disconnect_all.svg"/>
            <action id="ProxyCommander.KeepSelectedDeviceAction"
                    class="io.github.andriyo.proxycommander.KeepSelectedDeviceAction"
                    text="Select Emulator and Disconnect Others"
                    description="Choose one connected emulator and disconnect all other devices"
                    icon="/icons/proxy_keep_selected.svg"/>
            <separator/>
            <action id="ProxyCommander.SettingsAction"
                    class="io.github.andriyo.proxycommander.ProxyCommanderSettingsAction"
                    text="Settings..."
                    description="Configure Proxy Commander port and adb path"
                    icon="/icons/proxy_settings.svg"/>
            <action id="ProxyCommander.StreamingContextTestAction"
                    class="io.github.andriyo.proxycommander.StreamingToolbarContextTestAction"
                    text="Show Current Device Context (Test)"
                    description="Show serial and kind for the device from Running Devices context"
                    icon="/icons/proxy_context.svg"/>
        </group>
        <reference ref="ProxyCommander.ConnectAllDevicesAction">
            <add-to-group group-id="StreamingToolbarSecondary" anchor="last"/>
        </reference>
        <reference ref="ProxyCommander.ConnectActiveEmulatorClearOthersProxyAction">
            <add-to-group group-id="StreamingToolbarSecondary" anchor="after" relative-to-action="ProxyCommander.ConnectAllDevicesAction"/>
        </reference>
        <reference ref="ProxyCommander.DisconnectAllDevicesAction">
            <add-to-group group-id="StreamingToolbarSecondary" anchor="after" relative-to-action="ProxyCommander.ConnectActiveEmulatorClearOthersProxyAction"/>
        </reference>
        <reference ref="ProxyCommander.ConnectAllDevicesAction">
            <add-to-group group-id="ToolbarRunGroup" anchor="after" relative-to-action="AndroidConnectDebuggerAction"/>
            <add-to-group group-id="RunMenu" anchor="after" relative-to-action="AndroidConnectDebuggerAction"/>
        </reference>
        <reference ref="ProxyCommander.ConnectActiveEmulatorClearOthersProxyAction">
            <add-to-group group-id="ToolbarRunGroup" anchor="after" relative-to-action="ProxyCommander.ConnectAllDevicesAction"/>
            <add-to-group group-id="RunMenu" anchor="after" relative-to-action="ProxyCommander.ConnectAllDevicesAction"/>
        </reference>
    </actions>
</idea-plugin>
