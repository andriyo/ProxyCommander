<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.andrii.ProxyCommander</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>ProxyCommander</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.yourcompany.com">YourCompany</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Enter short description for your plugin here.<br>
        <em>most HTML tags may be used</em>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.androidstudio</depends>
    <depends>org.jetbrains.android</depends>
    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <actions>
        <group id="ProxyCommander.ActionsGroup" text="Proxy Commander" description="Proxy Commander device actions" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="ProxyCommander.ConnectAllDevicesAction"
                    class="com.andrii.proxycommander.ConnectAllDevicesAction"
                    text="Connect All Devices"
                    description="Enable reverse proxy and HTTP proxy on all connected devices"
                    icon="/icons/proxy_connect_all.svg"/>
            <action id="ProxyCommander.ConnectActiveEmulatorClearOthersProxyAction"
                    class="com.andrii.proxycommander.ConnectActiveEmulatorClearOthersProxyAction"
                    text="Connect Active Emulator and Clear Others Proxy"
                    description="Enable reverse+proxy for active emulator and clear proxy on all other connected devices"
                    icon="/icons/proxy_connect_active.svg"/>
            <action id="ProxyCommander.FillPasswordOnActiveDeviceAction"
                    class="com.andrii.proxycommander.FillPasswordOnActiveDeviceAction"
                    text="Fill Password on Active Device"
                    description="Detect password field and fill configured development password"
                    icon="/icons/proxy_fill_password.svg"/>
            <action id="ProxyCommander.DisconnectAllDevicesAction"
                    class="com.andrii.proxycommander.DisconnectAllDevicesAction"
                    text="Disconnect All Devices"
                    description="Disable reverse proxy and clear HTTP proxy on all connected devices"
                    icon="/icons/proxy_disconnect_all.svg"/>
            <action id="ProxyCommander.KeepSelectedDeviceAction"
                    class="com.andrii.proxycommander.KeepSelectedDeviceAction"
                    text="Select Device and Disconnect Others"
                    description="Choose one connected device and disconnect all other devices"
                    icon="/icons/proxy_keep_selected.svg"/>
            <separator/>
            <action id="ProxyCommander.SettingsAction"
                    class="com.andrii.proxycommander.ProxyCommanderSettingsAction"
                    text="Settings..."
                    description="Configure Proxy Commander port and adb path"
                    icon="/icons/proxy_settings.svg"/>
            <action id="ProxyCommander.StreamingContextTestAction"
                    class="com.andrii.proxycommander.StreamingToolbarContextTestAction"
                    text="Show Current Device Context (Test)"
                    description="Show serial and kind for the device from Running Devices context"
                    icon="/icons/proxy_context.svg"/>
        </group>
        <action id="ProxyCommander.StreamingContextTestAction.Toolbar"
                class="com.andrii.proxycommander.StreamingToolbarContextTestAction"
                text="Proxy Context"
                description="Show serial and kind for current Running Devices panel"
                icon="/icons/proxy_context.svg">
            <add-to-group group-id="StreamingToolbarSecondary" anchor="last"/>
        </action>
        <reference ref="ProxyCommander.ConnectActiveEmulatorClearOthersProxyAction">
            <add-to-group group-id="StreamingToolbarSecondary" anchor="last"/>
        </reference>
        <reference ref="ProxyCommander.FillPasswordOnActiveDeviceAction">
            <add-to-group group-id="StreamingToolbarSecondary" anchor="last"/>
        </reference>
        <reference ref="ProxyCommander.ConnectAllDevicesAction">
            <add-to-group group-id="ToolbarRunGroup" anchor="after" relative-to-action="AndroidConnectDebuggerAction"/>
            <add-to-group group-id="RunMenu" anchor="after" relative-to-action="AndroidConnectDebuggerAction"/>
        </reference>
        <reference ref="ProxyCommander.ConnectActiveEmulatorClearOthersProxyAction">
            <add-to-group group-id="ToolbarRunGroup" anchor="after" relative-to-action="ProxyCommander.ConnectAllDevicesAction"/>
            <add-to-group group-id="RunMenu" anchor="after" relative-to-action="ProxyCommander.ConnectAllDevicesAction"/>
        </reference>
        <reference ref="ProxyCommander.FillPasswordOnActiveDeviceAction">
            <add-to-group group-id="ToolbarRunGroup" anchor="after" relative-to-action="ProxyCommander.ConnectActiveEmulatorClearOthersProxyAction"/>
            <add-to-group group-id="RunMenu" anchor="after" relative-to-action="ProxyCommander.ConnectActiveEmulatorClearOthersProxyAction"/>
        </reference>
    </actions>
</idea-plugin>
